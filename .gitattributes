# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Source code
*.php text eol=lf diff=php

# Configuration files
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
composer.lock text eol=lf merge=union

# Documentation
*.md text eol=lf

# Shell scripts
*.sh text eol=lf

# Environment files
.env* text eol=lf

# Git files
.gitattributes text eol=lf
.gitignore text eol=lf

# Export-ignore (exclude from composer archive)
/.github export-ignore
# tests/ is not shipped, except the wire contract (tests/Smoke/Contract): git archive does not descend into an
# export-ignored directory, so every sibling is listed and the Contract directory is the one left out.
/tests/bootstrap.php export-ignore
/tests/Fixture export-ignore
/tests/Integration export-ignore
/tests/Support export-ignore
/tests/Unit export-ignore
/tests/reports export-ignore
/tests/Smoke/Fixture export-ignore
/tests/Smoke/Support export-ignore
/tests/Smoke/SmokeTest.php export-ignore
/tests/Smoke/WireContractTest.php export-ignore
/support export-ignore
/.claude/CLAUDE.md export-ignore
/.claude/cache export-ignore
/.claude/settings.local.json export-ignore
/vendor export-ignore
.idea export-ignore
.editorconfig export-ignore
.dockerignore export-ignore
.gitattributes export-ignore
.composer.lock export-ignore
.gitignore export-ignore
Makefile export-ignore
phpcs.xml export-ignore
phpstan.neon export-ignore
phpunit.xml export-ignore
.env export-ignore
